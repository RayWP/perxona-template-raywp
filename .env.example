# Browser/server app
PORT=3000

# Perxona Connect API. The secret stays server-side; the publishable key is
# intentionally returned to the browser for presenter.initializeWithConnectKey.
PERXONA_API_BASE_URL=https://console.perxona.ai/asia
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=
PERXONA_AVATAR_ID=
PERXONA_SCENE_ID=
PERXONA_VOICE_ID=
# Optional region-specific override. The official region-neutral default is used when blank.
PERXONA_PRESENTER_URL=https://cdn.perxona.ai/prod/latest/widget/entry/presenter.js

# Optional browser-only avatar test. These values are safe to expose in the
# frontend. Do not put PERXONA_CONNECT_SECRET_KEY in a NEXT_PUBLIC variable.
NEXT_PUBLIC_PERXONA_CONNECT_PUBLISHABLE_KEY=
NEXT_PUBLIC_PERXONA_AVATAR_ID=
NEXT_PUBLIC_PERXONA_SCENE_ID=
NEXT_PUBLIC_PERXONA_VOICE_ID=
NEXT_PUBLIC_PERXONA_PRESENTER_URL=https://cdn.perxona.ai/prod/latest/widget/entry/presenter.js
# Optional: set a motion ID only when you have verified it in the avatar catalog.
NEXT_PUBLIC_PERXONA_MOTION_ID=

# Any OpenAI-compatible Chat Completions provider. OpenRouter is the default.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_SITE_URL=
LLM_APP_NAME=Perxona Hackathon Template

# Optional OpenAI-compatible embeddings. For OpenRouter, set these explicitly
# to a verified embeddings-capable endpoint/model.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
